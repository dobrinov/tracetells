{
  "name": "@tracetells/node",
  "version": "0.1.0",
  "description": "Report Node.js server errors to Trace (tracetells.com): error facts only, scrubbed, in the background",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dobrinov/tracetells.git", "directory": "clients/node" },
  "homepage": "https://tracetells.com/docs/server-errors/",
  "keywords": ["errors", "error-tracking", "monitoring", "privacy", "express", "fastify", "trace"],
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\": \\\"commonjs\\\"}\\n')\"",
    "test": "npm run build && node --test test/"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "express": "^4.21.2",
    "fastify": "^5.2.0",
    "typescript": "^5.7.2"
  }
}
