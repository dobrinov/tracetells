{
  "product": "Stride",
  "events": {
    "add_to_cart": "A shopper added a pair of shoes to the cart (data-trace-event on the Add to cart button)",
    "purchase": "Payment succeeded; sent once per order from the checkout code",
    "signup_completed": "A Stride+ account was created"
  },
  "kpis": {
    "checkout_conversion": {
      "name": "Checkout conversion",
      "description": "Share of sessions reaching checkout that complete payment",
      "conversion": {
        "from": {
          "pageview": "{{BASE}}/checkout"
        },
        "to": {
          "pageview": "{{BASE}}/checkout/success"
        }
      },
      "goal": "increase",
      "target": "55%"
    },
    "signup_completion": {
      "name": "Signup completion",
      "description": "Share of sessions that start the signup form and finish it",
      "conversion": {
        "from": {
          "form_start": "{{BASE}}/signup"
        },
        "to": {
          "event": "signup_completed"
        }
      },
      "goal": "increase",
      "target": "60%"
    },
    "js_errors": {
      "name": "Sessions with errors",
      "description": "Share of sessions with any exception, console error, failed request or missing file",
      "session_rate": {
        "error": "*"
      },
      "goal": "decrease",
      "target": "1%"
    }
  },
  "areas": {
    "catalogue": {
      "name": "Catalogue",
      "description": "Finding shoes",
      "features": {
        "home": { "name": "Home page", "match": [{ "pageview": "{{BASE}}/" }] },
        "listing": { "name": "All products", "match": [{ "pageview": "{{BASE}}/products" }] },
        "product": { "name": "Product page", "match": [{ "pageview": "{{BASE}}/products/:id" }] }
      }
    },
    "buying": {
      "name": "Buying",
      "description": "Cart, checkout and payment",
      "features": {
        "cart": { "name": "Cart", "match": [{ "pageview": "{{BASE}}/cart" }, { "event": "add_to_cart" }] },
        "checkout": { "name": "Checkout", "match": [{ "pageview": "{{BASE}}/checkout" }] },
        "paid": { "name": "Paid", "match": [{ "event": "purchase" }] }
      }
    },
    "membership": {
      "name": "Stride+",
      "description": "The membership",
      "features": {
        "pricing": { "name": "Pricing", "match": [{ "pageview": "{{BASE}}/pricing" }] },
        "signup": { "name": "Sign-up", "match": [{ "pageview": "{{BASE}}/signup" }, { "event": "signup_completed" }] }
      }
    }
  },
  "audience": {
    "marketing": ["{{BASE}}/", "{{BASE}}/pricing"],
    "engaged": [{ "event": "add_to_cart" }, { "event": "signup_completed" }, { "event": "purchase" }]
  },
  "funnels": {
    "purchase": {
      "name": "From a product to a purchase",
      "description": "A shoe's page, into the cart, through checkout to payment",
      "steps": [
        {
          "pageview": "{{BASE}}/products/:id"
        },
        {
          "event": "add_to_cart"
        },
        {
          "pageview": "{{BASE}}/cart"
        },
        {
          "pageview": "{{BASE}}/checkout"
        },
        {
          "event": "purchase"
        }
      ]
    },
    "signup": {
      "name": "Stride+ sign-up",
      "description": "The pricing page, the sign-up form, an account",
      "steps": [
        {
          "pageview": "{{BASE}}/pricing"
        },
        {
          "pageview": "{{BASE}}/signup"
        },
        {
          "event": "signup_completed"
        }
      ]
    }
  }
}
